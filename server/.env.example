# 复制成 .env 后按部署环境改。没写的用 settings.py 里的默认值。
# DATABASE_URL=postgresql+psycopg://user:password@host/customer_agent
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=          # Qdrant 设了访问密钥时填
# MODELS_DIR=/data/models
# HF_ENDPOINT=https://hf-mirror.com   # 下模型的地址，默认 huggingface.co
# HF_HOME=/data/hf
# UPLOADS_DIR=/data/uploads
# IMAGES_DIR=/data/images   # 买家在聊天里发的图，随聊天记录 90 天清掉
# TIMEZONE=Asia/Shanghai   # 业务时区：每天的限额和统计从这里的零点开始
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}   # 每次请求额外带的参数，换供应商时改；{} 表示不带
# DEEPSEEK_API_KEY=
# ADMIN_USER=admin
# ADMIN_PASSWORD=           # 管理后台的密码，不配时后台不开放
# ADMIN_COOKIE_SECURE=0     # 后台没有 HTTPS 时才设（默认登录 cookie 只走 HTTPS，localhost 除外）
# SERVICE_API_KEY=        # 接入方调对话接口用，不配时对话接口不开放
# TELEGRAM_BOT_TOKEN=     # Telegram 机器人的令牌；不配就不启用（docs/10）
# TELEGRAM_INDEX_ID=      # Telegram 上用哪个索引回答
# TELEGRAM_PROXY=         # 连 Telegram 要走的代理，比如 http://127.0.0.1:端口；能直连就不配
# SHOP_URL=http://127.0.0.1:8100   # 接入方的店铺接口
# SHOP_API_KEY=            # 调店铺接口用，和接入方那边配的一样
