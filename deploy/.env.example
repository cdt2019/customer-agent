# 复制成 deploy/.env 再填。密钥都用随机值，比如 openssl rand -hex 24。这个文件不进版本管理。
POSTGRES_PASSWORD=
QDRANT_API_KEY=
DEEPSEEK_API_KEY=
ADMIN_PASSWORD=
SERVICE_API_KEY=        # 接入方调对话接口用
SHOP_API_KEY=           # 客服服务调店铺接口用
TOKEN_SECRET=           # 模拟店铺签访客令牌用

# 下面有默认值，按需改
# LLM_MODEL=deepseek-flash
# TIMEZONE=Asia/Shanghai  # 业务时区：每天的限额和统计从这里的零点开始
# INDEX_ID=1              # 聊天窗用哪个索引版本，建好索引后看 agent 的输出
# ADMIN_PORT=18080        # 后台发布在本机的端口
# DEMO_PORT=18100         # 模拟店铺发布在本机的端口
# ADMIN_COOKIE_SECURE=0   # 后台不走 HTTPS、又不是用 localhost 打开时设
# CGROUP_PARENT=customer-agent.slice   # 容器放进哪个 systemd 资源组
# SHOP_URL=http://demo:8100            # 接真实接入方时改成它的店铺接口
# TELEGRAM_BOT_TOKEN=                  # Telegram 机器人的令牌（@BotFather 给的）；不配就不启用（docs/10）
# TELEGRAM_INDEX_ID=                   # Telegram 上用哪个索引回答，建好索引后填编号
