# 模拟店铺的配置。复制成 .env 再填。
# AGENT_URL=http://127.0.0.1:8000
# AGENT_KEY=                # 和 server/.env 的 SERVICE_API_KEY 一样
# INDEX_ID=1                # 聊天窗用哪个索引版本
# SHOP_API_KEY=             # 和 server/.env 的 SHOP_API_KEY 一样
# TOKEN_SECRET=             # 签访客令牌用，随便一串够长的随机字符
# TOKEN_MINUTES=10
# WIDGET_DIR=../widget/dist
